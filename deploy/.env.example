APP_URL=https://mcp.example.com
APP_PORT=8080
POSTGRES_DB=iobroker_gateway
POSTGRES_USER=iobroker_gateway
POSTGRES_PASSWORD=<random-secret>
DATABASE_URL=postgresql://iobroker_gateway:<random-secret>@postgres:5432/iobroker_gateway
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
MQTT_TLS_PORT=8884
REMEMBER_DAYS=30
MQTT_URL=mqtt://broker:1883
MQTT_APP_USERNAME=iobroker_mcp_app
MQTT_APP_PASSWORD=<random-secret>
MQTT_PREFIX=iobroker/mcp/v1
